{
  "name": "special-homework-front",
  "version": "1.0.0",
  "main": "./main.tsx",
  "author": "KTS",
  "license": "MIT",
  "scripts": {
    "rm-public": "rm -rf ./public",
    "rm-source-maps": "find ./public -name *.js.map -type f -delete",
    "dev": "vite --port 8080 --host",
    "build": "yarn rm-public && vite build && yarn run rm-source-maps",
    "preview": "vite preview --port 8080",
    "tsc:check": "tsc --project tsconfig.json",
    "lint": "eslint . --ext ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext ts,.tsx,.js,.jsx --fix ",
    "stylelint": "stylelint --ignore-path .gitignore \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint --ignore-path .gitignore \"**/*.{css,scss}\" --fix",
    "format": "yarn lint:fix && yarn stylelint:fix",
    "check-circular-deps": "bash scripts/check-circular-deps.sh",
    "check-circular-deps:json": "bash scripts/check-circular-deps-json.sh",
    "precommit": "yarn check-circular-deps && yarn tsc:check && lint-staged",
    "prepare": "husky"
  },
  "homepage": "./",
  "commands": [
    "yarn build"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,scss,css}": [
      "yarn prettier --write"
    ],
    "*.{ts,js}?(x)": [
      "yarn lint"
    ],
    "*.{scss,css}": [
      "yarn stylelint"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not IE 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 ie version"
    ]
  },
  "dependencies": {
    "@kts-specials/mediaproject-stores": "^4.2.1",
    "@kts-specials/mediaproject-style": "^5.0.1",
    "@kts-specials/mediaproject-utils": "^6.0.1",
    "@sentry/react": "^8.9.2",
    "classnames": "^2.5.1",
    "clsx": "^2.0.0",
    "eruda": "^3.0.1",
    "framer-motion": "^10.16.5",
    "mobx": "^6.11.0",
    "mobx-react": "^9.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.7.1",
    "@commitlint/lint": "^18.5.0",
    "@sentry/vite-plugin": "^2.19.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@types/node": "^20.11.30",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.19",
    "commitlint-plugin-function-rules": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "glob": "^10.3.10",
    "husky": "^9.0.11",
    "jiti": "^2.4.2",
    "lint-staged": "^15.2.2",
    "madge": "^8.0.0",
    "postcss": "^8.4.38",
    "postcss-styled-syntax": "^0.6.4",
    "prettier": "^3.2.5",
    "react-is": "^18.2.0",
    "sass": "^1.72.0",
    "stylelint": "^16.2.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-declaration-strict-value": "^1.10.4",
    "stylelint-prettier": "^5.0.0",
    "stylelint-scss": "^6.2.1",
    "terser": "^5.16.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.4.2",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-svgr": "^5.2.0"
  }
}
